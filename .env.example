# Database URL (Local Docker Postgres)
DATABASE_URL=postgresql://fg_user:fg_pass@localhost:5432/fraudguard

# LLM API Keys (Required for M1 Threat Discovery)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Service URLs (For cross-service communication)
# When running locally via uvicorn, use localhost. In Docker, use the service name.
THREAT_SERVICE_URL=http://localhost:8001

# ── Member 5 — Risk & Decision Service ──────────────────────────
FEATURE_SERVICE_URL=http://localhost:8003
MODEL_SERVICE_URL=http://localhost:8000
RISK_SERVICE_PORT=8005
POLICY_VERSION=v1
# Thresholds below are development defaults — not production-validated
THRESHOLD_ALLOW_MAX=0.30
THRESHOLD_STEP_UP_MAX=0.50
THRESHOLD_REVIEW_MAX=0.70